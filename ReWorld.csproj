<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>ReWorld</RootNamespace>
    <AssemblyName>ReWorld</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Reassembly/ 目录是逆向参考代码，不参与 ReWorld 编译。 -->
  <ItemGroup>
    <Compile Remove="Reassembly\**\*.cs" />
    <Compile Remove="tools\reassembly\**\*.cs" />
  </ItemGroup>
</Project>
